{
  "$id": "https://kurult.ai/hulagu/schemas/wikimanifest-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "examples": [
    {
      "created_at": "2026-07-27T00:00:00Z",
      "files": [
        {
          "bytes": 256,
          "relative_path": "index.md",
          "sha256": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
        }
      ],
      "generation_id": "generation_synthetic_01",
      "schema_version": "WikiManifest/v1"
    }
  ],
  "properties": {
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "relative_path": {
            "pattern": "^[^/].*",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "relative_path",
          "sha256",
          "bytes"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "generation_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "WikiManifest/v1"
    }
  },
  "required": [
    "schema_version",
    "generation_id",
    "created_at",
    "files"
  ],
  "title": "WikiManifest/v1",
  "type": "object"
}
