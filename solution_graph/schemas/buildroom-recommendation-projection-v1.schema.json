{
  "$id": "https://kurult.ai/schemas/buildroom-recommendation-projection-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_invocation_count": {
      "const": 0
    },
    "authority": {
      "const": "none"
    },
    "dispatch_allowed": {
      "const": false
    },
    "links": {
      "items": {
        "pattern": "^solution-graph:plan_[0-9a-f]{20}@sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 1,
      "type": "array"
    },
    "mode": {
      "const": "recommendation_only"
    },
    "operator_decisions_needed": {
      "items": {
        "maxLength": 512,
        "type": "string"
      },
      "maxItems": 8,
      "type": "array"
    },
    "operator_needs_to_know": {
      "items": {
        "maxLength": 512,
        "type": "string"
      },
      "maxItems": 8,
      "type": "array"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^plan_[0-9a-f]{20}$",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "pattern": "^[a-z0-9_:-]+$",
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    },
    "requires_operator_approval": {
      "const": true
    },
    "room_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "BuildroomRecommendationProjection/v1"
    },
    "selected_artifacts": {
      "items": {
        "pattern": "^artifact:",
        "type": "string"
      },
      "maxItems": 3,
      "type": "array"
    },
    "simulation_status": {
      "enum": [
        "pass",
        "fail",
        "not_simulated"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema",
    "room_id",
    "mode",
    "plan_id",
    "plan_digest",
    "selected_artifacts",
    "reason_codes",
    "simulation_status",
    "artifact_invocation_count",
    "authority",
    "dispatch_allowed",
    "requires_operator_approval",
    "operator_needs_to_know",
    "operator_decisions_needed",
    "links"
  ],
  "title": "buildroom-recommendation-projection-v1",
  "type": "object"
}
