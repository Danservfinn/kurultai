{
  "$id": "https://kurult.ai/schemas/buildroom-recommendation-projection-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_invocation_count": {
      "const": 0
    },
    "authority": {
      "const": "none"
    },
    "dispatch_allowed": {
      "const": false
    },
    "links": {
      "items": {
        "pattern": "^(solution-graph:plan_[0-9a-f]{20}@sha256:[0-9a-f]{64}|shadow-case:case_[A-Za-z0-9_-]+)$",
        "type": "string"
      },
      "maxItems": 2,
      "type": "array"
    },
    "mode": {
      "enum": [
        "recommendation_only",
        "shadow_dogfood"
      ]
    },
    "operator_decisions_needed": {
      "items": {
        "maxLength": 512,
        "type": "string"
      },
      "maxItems": 8,
      "type": "array"
    },
    "operator_needs_to_know": {
      "items": {
        "maxLength": 512,
        "type": "string"
      },
      "maxItems": 8,
      "type": "array"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^plan_[0-9a-f]{20}$",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "pattern": "^[a-z0-9_:-]+$",
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    },
    "requires_operator_approval": {
      "const": true
    },
    "room_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "buildroom_refs": {
      "additionalProperties": false,
      "properties": {
        "implementation_receipt": {"pattern": "^buildroom:", "type": "string"},
        "operator_summary": {"pattern": "^buildroom:", "type": "string"},
        "retention_review": {"pattern": "^buildroom:", "type": "string"},
        "trust_report": {"pattern": "^buildroom:", "type": "string"},
        "verification_delta": {"pattern": "^buildroom:", "type": "string"}
      },
      "required": [
        "operator_summary",
        "implementation_receipt",
        "verification_delta",
        "trust_report",
        "retention_review"
      ],
      "type": "object"
    },
    "evaluation": {
      "additionalProperties": false,
      "properties": {
        "acceptance": {"enum": ["accepted", "overridden", "rejected", "not_yet_reviewed", "unknown"], "type": "string"},
        "correct_no_plan": {"enum": ["yes", "no", "not_applicable", "unknown"], "type": "string"},
        "deterministic_replay": {"enum": ["pass", "fail", "unknown"], "type": "string"},
        "false_rejection": {"enum": ["yes", "no", "not_applicable", "unknown"], "type": "string"},
        "post_build_verification_agreement": {"enum": ["agree", "disagree", "not_yet_reviewed", "unknown"], "type": "string"},
        "proof_debt": {"enum": ["none", "low", "medium", "high", "unknown"], "type": "string"},
        "review_state": {"enum": ["reviewed", "not_yet_reviewed", "unknown"], "type": "string"},
        "search_resource_ceiling": {"enum": ["within_bounds", "exhausted", "unknown"], "type": "string"}
      },
      "required": [
        "review_state",
        "acceptance",
        "correct_no_plan",
        "false_rejection",
        "proof_debt",
        "deterministic_replay",
        "search_resource_ceiling",
        "post_build_verification_agreement"
      ],
      "type": "object"
    },
    "schema": {
      "const": "BuildroomRecommendationProjection/v1"
    },
    "selected_artifacts": {
      "items": {
        "pattern": "^artifact:",
        "type": "string"
      },
      "maxItems": 3,
      "type": "array"
    },
    "simulation_status": {
      "enum": [
        "pass",
        "fail",
        "not_simulated"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema",
    "room_id",
    "mode",
    "plan_id",
    "plan_digest",
    "selected_artifacts",
    "reason_codes",
    "simulation_status",
    "artifact_invocation_count",
    "authority",
    "dispatch_allowed",
    "requires_operator_approval",
    "operator_needs_to_know",
    "operator_decisions_needed",
    "links"
  ],
  "title": "buildroom-recommendation-projection-v1",
  "type": "object"
}
