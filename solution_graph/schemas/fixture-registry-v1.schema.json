{
  "$id": "https://kurult.ai/schemas/fixture-registry-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "manifests": {
      "items": {
        "$ref": "https://kurult.ai/schemas/artifact-manifest-v1.schema.json"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "https://kurult.ai/schemas/evidence-observation-v1.schema.json"
      },
      "maxItems": 512,
      "type": "array"
    },
    "schema": {
      "const": "FixtureRegistry/v1"
    },
    "snapshot_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "manifests",
    "observations",
    "snapshot_id"
  ],
  "title": "fixture-registry-v1",
  "type": "object"
}
