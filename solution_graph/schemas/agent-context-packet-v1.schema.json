{
  "$id": "https://kurult.ai/schemas/agent-context-packet-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact:",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "version",
        "digest",
        "purpose"
      ],
      "type": "object"
    },
    "content_trust": {
      "const": "untrusted-structured-data"
    },
    "failure_behavior": {
      "type": "string"
    },
    "invocation": {
      "type": "object"
    },
    "network": {
      "type": "object"
    },
    "permissions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "plan_ref": {
      "pattern": "^plan_",
      "type": "string"
    },
    "prerequisites": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema": {
      "const": "AgentContextPacket/v1"
    },
    "secret_slots": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "verifier_ref": {
      "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._/@:+-]+$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "plan_ref",
    "artifact",
    "invocation",
    "prerequisites",
    "permissions",
    "network",
    "secret_slots",
    "failure_behavior",
    "verifier_ref",
    "content_trust"
  ],
  "title": "agent-context-packet-v1",
  "type": "object"
}
