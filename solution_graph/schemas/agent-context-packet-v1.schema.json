{
  "$id": "https://kurult.ai/schemas/agent-context-packet-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^artifact:",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "version",
        "digest",
        "purpose"
      ],
      "type": "object"
    },
    "content_trust": {
      "const": "untrusted-structured-data"
    },
    "failure_behavior": {
      "type": "string"
    },
    "invocation": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "const": "argv/v1"
        },
        "argv_template": {
          "items": {
            "pattern": "^(?:--[a-z0-9][a-z0-9-]*|\\{(?:input|output):[a-z0-9_-]+\\})$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "adapter",
        "argv_template"
      ],
      "type": "object"
    },
    "network": {
      "additionalProperties": false,
      "properties": {
        "destinations": {
          "items": {
            "pattern": "^[A-Za-z0-9.-]+$",
            "type": "string"
          },
          "type": "array"
        },
        "mode": {
          "enum": [
            "deny",
            "allowlist"
          ],
          "type": "string"
        }
      },
      "required": [
        "mode",
        "destinations"
      ],
      "type": "object"
    },
    "permissions": {
      "items": {
        "enum": [
          "read-only",
          "local-read",
          "sandbox-local-write",
          "host-write",
          "external-effect"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "plan_ref": {
      "pattern": "^plan_",
      "type": "string"
    },
    "prerequisites": {
      "items": {
        "pattern": "^[A-Za-z0-9._-]+@[A-Za-z0-9._+-]+$",
        "type": "string"
      },
      "type": "array"
    },
    "schema": {
      "const": "AgentContextPacket/v1"
    },
    "secret_slots": {
      "items": {
        "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
        "type": "string"
      },
      "type": "array"
    },
    "verifier_ref": {
      "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._/@:+-]+$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "plan_ref",
    "artifact",
    "invocation",
    "prerequisites",
    "permissions",
    "network",
    "secret_slots",
    "failure_behavior",
    "verifier_ref",
    "content_trust"
  ],
  "title": "agent-context-packet-v1",
  "type": "object"
}
